APP_NAME="Resin Art"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

# Database Configuration (MySQL for Production VPS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resin_art_db
DB_USERNAME=root
DB_PASSWORD=

# For Local SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="concierge@maisonresine.com"
MAIL_FROM_NAME="${APP_NAME} Atelier"

ADMIN_EMAIL="admin@maisonresine.com"
CONTACT_RATE_LIMIT_SUBMISSIONS=5
CONTACT_RATE_LIMIT_MINUTES=10

STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=inr
